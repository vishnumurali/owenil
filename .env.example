# ---------------------------------------------------------------------------
# Owenil environment variables. Copy to .env.local and fill in.
# .env.local is gitignored. NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Public (bundled into the browser build) --------------------------------
# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The *publishable* key (sb_publishable_...) or legacy "anon" key. Safe to ship
# ONLY because every table is protected by Row Level Security.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Public URL path the app is mounted on (must start and end with "/").
VITE_BASE_PATH=/owenil/
# Shows the "Developer tools" panel (premium switch, recurring trigger).
# The database still decides whether the caller is allowed to use them.
VITE_ENABLE_DEV_TOOLS=true
# Displayed Owenil Plus prices (display only — no payments are processed).
VITE_PLUS_PRICE_MONTHLY=₹149
VITE_PLUS_PRICE_YEARLY=₹1,299

# --- Server-side only (local scripts: migrations, seeding, DB tests) --------
# NEVER prefix these with VITE_ — that would leak them into the browser bundle.
# Supabase → Project Settings → API Keys → secret key (sb_secret_...) / service_role
SUPABASE_SECRET_KEY=
# Supabase → Connect → "Session pooler" connection string (includes DB password).
# Optional when SUPABASE_ACCESS_TOKEN is set (SQL then runs via the Management API).
SUPABASE_DB_URL=
# Personal access token (Dashboard → Account → Access Tokens). Lets
# `npm run supabase:provision` create/configure the project and run migrations.
SUPABASE_ACCESS_TOKEN=

# Optional: Google sign-in. Used only by "npm run supabase:provision -- --google",
# which stores them in Supabase Auth. Never needed by (or shipped to) the browser.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
